# Companion timer for research-swarm-cycle.service. Polls every 2 hours
# (after each run finishes) instead of once a day: the cycle itself is
# limited to one per CADENCE_DAYS by isCycleDue(), and the budget governor
# (dispatch-budget.js) denies a run -- authoring nothing -- while codex is
# out of credits. Polling means the swarm starts within ~2h of credits
# returning, with no human step. A denied poll costs one free failed probe.
[Unit]
Description=Poll research-swarm-cycle.service every 2 hours (one real cycle per day)

[Timer]
OnBootSec=10min
OnUnitInactiveSec=2h
Unit=research-swarm-cycle.service

[Install]
WantedBy=timers.target
