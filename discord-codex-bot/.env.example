# Copy this file to .env and fill in real values. .env is gitignored -- never commit real secrets.

# --- Discord (Discord Developer Portal -> your application) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly during dev/testing instead of
# waiting up to an hour for global command propagation. Leave blank to register globally.
DISCORD_GUILD_ID=

# --- Google Drive (Google Cloud Console -> OAuth client, Desktop app type) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by `npm run authorize-google` -- do not set by hand.
# GOOGLE_REFRESH_TOKEN is stored in tokens/google-token.json instead, not here.
# Optional, for /summarize's `all:true` mode: a dedicated Drive folder ID for meeting notes
# (copy the ID from the folder's URL). Required for `all` mode specifically -- without it,
# /summarize refuses `all:true` rather than sweeping the whole Drive. `query` mode works
# without this too, but results are sharper if it's set.
GOOGLE_DRIVE_MEETING_FOLDER_ID=

# --- OneDrive / Microsoft Graph (Azure Portal -> App registrations) ---
MS_CLIENT_ID=
# Personal Microsoft accounts (normal OneDrive, not OneDrive for Business): use "consumers".
# Work/school account: use your specific tenant ID instead.
MS_TENANT=consumers

# --- Codex dispatch ---
# Sandbox mode used for /ask dispatches. read-only is correct and sufficient -- the help
# agent uses Codex's hosted web-search tool, which does not need local shell network access.
CODEX_SANDBOX_MODE=read-only
